// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  username      String?     @unique
  email         String?     @unique
  telephone     String?
  postnom       String?
  prenom        String?
  dateOfBirth   DateTime?
  sexe          String?
  emailVerified Boolean @default(false)
  image         String?
  address       String?
  statusUser    Boolean?
  /// Compte créé avec mot de passe temporaire : forcer le changement à la 1ère connexion
  mustChangePassword Boolean @default(false)
  /// Préférence d'apparence propre à l'utilisateur (light | dark | system)
  theme       String?      @default("light")
  /// Langue d'interface (fr | en | pt)
  locale      String?      @default("fr")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  name        String
  role        String?
  banned      Boolean?     @default(false)
  banReason   String?
  banExpires  DateTime?
  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  platformSupportAgent     PlatformSupportAgent?
  platformEscalationsRequested PlatformSupportEscalation[] @relation("EscalationRequester")
  absenceCases             AbsenceCase[]        @relation("AbsenceCaseSubject")
  reviewedAbsenceCases     AbsenceCase[]        @relation("AbsenceCaseReviewer")
  appNotifications         AppNotification[]
  familyPaymentsCreated    FamilyPayment[]  @relation("FamilyPaymentCreatedBy")
  cashierExpensesCreated   CashierExpense[] @relation("CashierExpenseCreatedBy")

  @@index([telephone])
  @@index([role])
  @@index([statusUser])
  @@index([mustChangePassword])
  @@map("user")
}

model Parent {
  id             String           @id @default(cuid())
  branchMemberId         String
  branchMember           BranchMember?            @relation(fields: [branchMemberId], references: [id], onDelete: Cascade)
  /// Fonction / lieu de travail (optionnel, saisi à l'inscription)
  profession     String?
  /// Infos famille complémentaires (optionnelles)
  nomMere            String?
  professionMere     String?
  tuteurNom          String?
  adresseTuteur      String?
  provinceOrigine    String?
  territoireOrigine  String?
  secteurOrigine     String?
  villageOrigine     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  paymentBatches PaymentBatch[]
  familyPayments FamilyPayment[]
  discountRules  DiscountRule[]
  students       Student[]
  feedbacks      ParentFeedback[]

  @@unique([branchMemberId])
}

model Student {
  id                String              @id @default(cuid())
  branchMemberId    String
  parentId          String
  statusStudent     Boolean?             @default(false)
  observation      String?
  provenanceEcole String?
  placeOfBirth String?
  /// Infos élève complémentaires (optionnelles)
  nationalite               String?
  autreNationalite          String?
  territoireAutreNationalite String?
  langue                    String?
  suppositionClasseName String?
  suppositionSection String?
  suppositionOption String?
  parent            Parent              @relation(fields: [parentId], references: [id])
  category          StudentCategory     @default(NORMAL) // 🔥 AJOUT
  classEnrollment   ClassEnrollment[]
  branchMember              BranchMember                @relation(fields: [branchMemberId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  studentAttendance StudentAttendance[]
  grades            StudentGrade[]
  branchLinks       StudentBranchLink[]
  issuedDocuments   IssuedDocument[]
  onlineSubmissions OnlineSubmission[]

  @@index([parentId])
  @@unique([branchMemberId])
}

model AttendanceSession {
  id                   String              @id @default(cuid())
  teachingId           String
  teaching             Teaching            @relation(fields: [teachingId], references: [id])
  validatedByTeacherId String?
  validatedByTeacher   Teacher?            @relation(fields: [validatedByTeacherId], references: [id])
  date                 DateTime
  startTime            DateTime
  endTime              DateTime
  isClosed             Boolean             @default(false)
  closedAt             DateTime?
  schoolYearId         String
  schoolYear           SchoolYear          @relation(fields: [schoolYearId], references: [id])
  createdAt            DateTime            @default(now())
  attendances          StudentAttendance[]
  teacherAttendance    TeacherAttendance[]
  branchId             String?
  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([teachingId, date, startTime])
  @@index([branchId])
  @@index([branchId, date])
  @@index([schoolYearId])
  @@index([validatedByTeacherId])
}

model StudentAttendance {
  id            String            @id @default(cuid())
  sessionId     String
  justification String?
  session       AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id])
  status        AttendanceStatus
  remark        String?
  /// Heure d'arrivée / pointage
  checkIn       DateTime?
  /// Heure de sortie (fin de vacation ou sortie anticipée)
  checkOut      DateTime?
  /// Sortie avant la fin prévue de la vacation
  earlyExit     Boolean           @default(false)
  /// Motif de sortie anticipée (maladie, urgence, etc.)
  exitReason    String?
  exitReasonCode AttendanceExitReason?
  createdAt     DateTime          @default(now())
  recordedAt    DateTime          @default(now())
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  absenceCase          AbsenceCase?

  @@unique([branchId, sessionId, studentId])
  @@index([studentId])
  @@index([status])
  @@index([recordedAt])
  @@index([branchId, recordedAt])
  @@index([branchId, earlyExit])
}

model TeacherAttendance {
  id        String            @id @default(cuid())
  teacherId String
  teacher   Teacher           @relation(fields: [teacherId], references: [id])
  sessionId String
  date      DateTime
  status    AttendanceStatus
  remark    String?
  /// Début effectif du cours (pointage)
  checkIn   DateTime?
  /// Fin effective du cours (pointage sortie ou fin de séance)
  checkOut  DateTime?
  earlyExit Boolean           @default(false)
  exitReason String?
  exitReasonCode AttendanceExitReason?
  createdAt DateTime          @default(now())
  session   AttendanceSession @relation(fields: [sessionId], references: [id])
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  absenceCase          AbsenceCase?

  @@unique([teacherId, sessionId, branchId])
  @@index([branchId])
  @@index([branchId, date])
  @@index([branchId, earlyExit])
}

model PersonnelAttendance {
  id          String           @id @default(cuid())
  personnelId String
  personnel   Personnel        @relation(fields: [personnelId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus
  remark      String?
  earlyExit   Boolean          @default(false)
  exitReason  String?
  exitReasonCode AttendanceExitReason?
  createdAt   DateTime         @default(now())
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  absenceCase          AbsenceCase?

  @@unique([personnelId, date,branchId])
  @@index([branchId])
  @@index([branchId, date])
  @@index([branchId, earlyExit])
}

model ParentFeedback {
  id           String      @id @default(cuid())
  parentId     String
  rating       Int
  comment      String?
  month        Int // 1-12
  schoolYearId String
  createdAt    DateTime    @default(now())
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id]) // ✅ RELATION
  parent       Parent      @relation(fields: [parentId], references: [id])
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([parentId, month, schoolYearId])
  @@index([branchId])
  @@index([branchId, schoolYearId])
}

model StudentGrade {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  periodId     Int
  period       period     @relation(fields: [periodId], references: [id])
  score        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Empêche plusieurs notes pour le même élève dans la même période
  @@index([studentId])
  @@index([schoolYearId])
  @@index([periodId])
  @@unique([studentId, periodId, branchId])
  @@index([branchId])
  @@index([branchId, schoolYearId])
  @@index([branchId, periodId])
}

model Personnel {
  id                  String                @id @default(cuid())
  branchMemberId              String
  branchMember                BranchMember?                 @relation(fields: [branchMemberId], references: [id], onDelete: Cascade)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  personnelAttendance PersonnelAttendance[]

  @@unique([branchMemberId])
}

model Frais {
  id           String          @id @default(cuid())
  nameFrais    String
  montantFrais Decimal         @db.Decimal(10, 2)
  statusFrais  Boolean         @default(true)
  classeId     String
  typeFraisId  String
  echeance     DateTime?
  schoolYearId String? // 👈 TEMPORAIRE (optionnel)
  priority     Int             @default(99) // 🔥 AJOUT (1 = haute priorité)
  paiement     FamilyPayment[]
  classe       Classe          @relation(fields: [classeId], references: [id])
  typeFrais    TypeFrais       @relation(fields: [typeFraisId], references: [id])
  schoolYear   SchoolYear?     @relation(fields: [schoolYearId], references: [id]) // ✅ RELATION
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // ✅ IMPORTANT
  @@index([classeId])
  @@index([schoolYearId])
  @@index([typeFraisId])
  @@index([branchId])
  @@index([branchId, schoolYearId])
  @@index([branchId, classeId])
}

model TypeFrais {
  id          String  @id @default(cuid())
  codeType    String  @unique
  nameType    String
  description String?
  statusType  Boolean @default(true)
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  frais         Frais[]
  discountRules DiscountRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId])
}

model Classe {
  id              String            @id @default(cuid())
  codeClasse      String
  nameClasse      String
  level           String?
  parallel        String?
  capacity        Int?
  optionId        String?
  statusClasse    Boolean?
  creneauId       String?
  /// COMPLET = présence tous les jours (2.º Ciclo 10ª–12ª). REDUIT = ciclo longo 13ª.
  horaireType     HoraireType     @default(COMPLET)
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classEnrollment ClassEnrollment[]
  teaching        Teaching[]
  Frais           Frais[]
  option          Option?           @relation(fields: [optionId], references: [id])
  creneau         Creneau?          @relation(fields: [creneauId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  CalendarEvent   CalendarEvent[]
  fiche           fiche[]
  onlineAssignments OnlineAssignment[]
  @@index([branchId])
  @@index([optionId])
  @@index([branchId, optionId])
  @@unique([branchId, codeClasse])
  @@unique([branchId, nameClasse])
  @@index([branchId, level])
}

model Creneau {
  id                 String   @id @default(cuid())
  nameCreneau        String
  startTime          DateTime @db.Time
  endTime            DateTime @db.Time
  durationCourse     Int
  recreationHour     DateTime @db.Time
  recreationDuration Int
  isArchived         Boolean  @default(false)
  archivedAt         DateTime?
  archivedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
  @@index([branchId, isArchived])
  @@unique([branchId, nameCreneau])
  classe Classe[]
}

model Option {
  id           String   @id @default(cuid())
  codeOption   String
  nameOption   String
  sectionId    String?
  section      Section? @relation(fields: [sectionId], references: [id])
  classe       Classe[]
  coursPonderations CoursOptionPonderation[]
  statusOption Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
  @@index([sectionId])
  @@index([branchId, sectionId])
  @@unique([branchId, codeOption])
  @@unique([branchId, nameOption])
}

model Section {
  id            String   @id @default(cuid())
  codeSection   String
  nameSection   String
  option        Option[]
  statusSection Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
  @@unique([branchId, codeSection])
  @@unique([branchId, nameSection])
}

model SchoolYear {
  id                String              @id @default(cuid())
  nameYear          String
  startYear         DateTime
  endYear           DateTime
  isCurrentYear     Boolean             @default(false)
  isArchived        Boolean             @default(false)
  archivedAt        DateTime?
  archivedById      String?
  classEnrollment   ClassEnrollment[]
  teaching          Teaching[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  frais             Frais[] // ✅ OPTIONNEL MAIS PROPRE
  CalendarEvent     CalendarEvent[]
  invoices          Invoice[]
  grades            StudentGrade[]
  parentFeedback    ParentFeedback[]
  attendanceSession AttendanceSession[]
  issuedDocuments   IssuedDocument[]
  registrationInfos BranchRegistrationInfo[]
  onlineAssignments OnlineAssignment[]
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId, startYear, endYear])
  @@index([branchId, isCurrentYear])
  @@index([branchId, isArchived])
  @@unique([branchId, startYear, endYear])
  @@unique([branchId, nameYear])
}

model ClassEnrollment {
  id               String          @id @default(cuid())
  schoolYearId     String
  classeId         String
  studentId        String
  /// Codes examen officiel (TENAFEP / listing finalistes) — par année scolaire
  e13              String?
  e80              String?
  paiement         FamilyPayment[]
  schoolYear       SchoolYear      @relation(fields: [schoolYearId], references: [id])
  classe           Classe?         @relation(fields: [classeId], references: [id])
  student          Student?        @relation(fields: [studentId], references: [id])
  statusEnrollment Boolean?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  invoices         Invoice[]
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, studentId])
  @@index([schoolYearId])
  @@index([classeId])
  @@index([studentId])
  @@index([branchId])
  @@index([branchId, classeId])
  @@index([branchId, schoolYearId])
  /// Liste finalistes / inscriptions actives par branche + année (+ classe).
  @@index([branchId, schoolYearId, statusEnrollment])
  @@index([branchId, schoolYearId, statusEnrollment, classeId])
}

model Teacher {
  id                String              @id @default(cuid())
  branchMemberId            String?
  teaching          Teaching[]
  branchMember              BranchMember?               @relation(fields: [branchMemberId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  fiche             fiche[]
  teacherAttendance TeacherAttendance[]
  attendanceSession AttendanceSession[]
  onlineAssignments OnlineAssignment[]

  @@unique([branchMemberId])
}

model Teaching {
  id                String              @id @default(cuid())
  teacherId         String
  classeId          String
  schoolYearId      String
  titulaire         Boolean?
  statusTeaching    Boolean?
  branchId          String?
  branch            Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  teacher           Teacher?            @relation(fields: [teacherId], references: [id])
  classe            Classe?             @relation(fields: [classeId], references: [id])
  schoolYear        SchoolYear?         @relation(fields: [schoolYearId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cours             Cours               @relation(fields: [coursId], references: [id])
  coursId           String
  CalendarEvent     CalendarEvent[]
  Schedule          Schedule[]
  fiche             fiche[]
  attendanceSession AttendanceSession[]

  @@unique([classeId, schoolYearId, coursId])
  @@index([teacherId])
  @@index([classeId])
  @@index([schoolYearId])
  @@index([branchId])
  @@index([branchId, teacherId])
  @@index([branchId, classeId])
  @@index([branchId, schoolYearId])
}

model Cours {
  id          String     @id @default(cuid())
  codeCours   String 
  nameCours   String
  description String?
  teaching    Teaching[]
  statusCours Boolean?
  /// Code domaine bulletin primaire (BranchPrimaryDomain.code) — null si non classé
  primaryDomain  String?
  /// Section affichée sous le domaine (ex. LANGUES CONGOLAISES) — null = pas de sous-en-tête
  primarySection String?
  /// Ordre d'affichage dans le bulletin primaire
  domainOrder    Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  period      period[]   @relation("PeriodSubjects")
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  coursPonderations CoursOptionPonderation[]
  onlineAssignments OnlineAssignment[]
  @@index([branchId])
  @@index([branchId, primaryDomain])
  @@unique([branchId, codeCours])
  @@unique([branchId, nameCours])
}
model CoursOptionPonderation {
  id          String   @id @default(cuid())
  coursId     String
  cours       Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)
  optionId    String
  option      Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /** Unités de max période : max = ponderation × 10 (ex. 1 → 10, 0.5 → 5). */
  ponderation Float
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, coursId, optionId])
  @@index([branchId])
  @@index([coursId])
  @@index([optionId])
}
model Schedule {
  id           String    @id @default(cuid())
  day          Day
  hour         DateTime  @db.Time
  teachingId   String?
  createdBy    String?
  isArchived   Boolean   @default(false)
  archivedAt   DateTime?
  archivedById String?
  branchMember       BranchMember?     @relation(fields: [createdBy], references: [id])
  teaching   Teaching? @relation(fields: [teachingId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([day, hour, teachingId], map: "unique_schedule_per_teacher")
  @@index([teachingId])
  @@index([createdBy])
  @@index([isArchived])
}

enum Day {
  Dimanche
  Lundi
  Mardi
  Mercredi
  Jeudi
  Vendredi
  Samedi
}

model CalendarEvent {
  id           String    @id @default(cuid())
  title        String?
  dateStart    DateTime
  dateEnd      DateTime?
  image        String?
  allDay       Boolean   @default(false)
  location     String?
  description  String?
  /// Traductions titre: { fr?, en?, pt?, ln? }
  titleI18n    Json?
  /// Traductions description: { fr?, en?, pt?, ln? }
  descriptionI18n Json?
  createdBy    String
  isArchived   Boolean   @default(false)
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  schoolYearId String
  teachingId   String?
  typeId       String?
  classeId     String?
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  teaching   Teaching?   @relation(fields: [teachingId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])
  eventType  EventType?  @relation(fields: [typeId], references: [id])

  recurrence Recurrence? @default(HEBDOMADAIRE)
  classe     Classe?     @relation(fields: [classeId], references: [id])

  @@index([schoolYearId])
  @@index([typeId])
  @@index([branchId])
  @@index([branchId, schoolYearId])
  @@index([branchId, dateStart])
}

model EventType {
  id     String          @id @default(cuid())
  name   String          @unique
  events CalendarEvent[]
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId])
  @@unique([branchId, name])
}

model semester {
  id        Int      @id @default(autoincrement())
  label     String
  startDate DateTime
  endDate   DateTime
  period    period[]
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
  @@unique([branchId, label])
}

model period {
  id                Int            @id @default(autoincrement())
  label             String
  startDate         DateTime
  endDate           DateTime
  semesterId        Int
  fiche             fiche[]
  gradesGenerated   Boolean        @default(false) // 👈 AJOUT
  gradesGeneratedAt DateTime?
  semester          semester       @relation(fields: [semesterId], references: [id])
  subject           Cours[]        @relation("PeriodSubjects")
  grades            StudentGrade[]
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([semesterId], map: "Period_semesterId_fkey")
  @@index([branchId])
  @@index([branchId, semesterId])
  @@unique([branchId, semesterId, label])
}

model PeriodResultLock {
  id        String   @id @default(cuid())
  periodId  Int
  status    String
  createdAt DateTime @default(now())
  updateAT  DateTime @default(now())
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([periodId])
  @@index([branchId])
  @@unique([branchId, periodId])
}

model fiche {
  id             String   @id
  dateCreated    DateTime @default(now())
  dateUpdated    DateTime
  status         Boolean  @default(false)
  teacherId      String
  typeFiche      String
  classSectionId String
  lessonId       String
  coursName      String
  classeName     String
  periodId       Int
  periodeName    String
  anneeId        String
  anneeName      String
  notes          String   @db.Text
  autres         String   @db.Text
  /// Lien vers le devoir / évaluation en ligne (1 fiche max par activité)
  onlineAssignmentId String? @unique
  onlineAssignment   OnlineAssignment? @relation(fields: [onlineAssignmentId], references: [id], onDelete: SetNull)
  ClassSection   Classe   @relation(fields: [classSectionId], references: [id], map: "Fiche_Id_fkey")
  lesson         Teaching @relation(fields: [lessonId], references: [id])
  period         period   @relation(fields: [periodId], references: [id])
  teacher        Teacher  @relation(fields: [teacherId], references: [id], map: "Fiche_teacherId_fkey")
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([lessonId], map: "Fiche_lessonId_fkey")
  @@index([periodId], map: "Fiche_periodId_fkey")
  @@index([branchId])
  @@index([branchId, anneeId])
  @@index([branchId, periodId])
  @@index([branchId, teacherId])
}

enum Recurrence {
  JOURNALIER
  HEBDOMADAIRE
  MENSUEL
  SEMESTRIEL
  TRIMESTRIEL
  ANNUEL
}

enum ActionType {
  LOGIN
  LOGOUT
  VISITED_PAGE
  ACTION
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
  OTHER
}

//////////////////////////////////////////////////////
// INVOICES
//////////////////////////////////////////////////////

model Invoice {
  id           Int    @id @default(autoincrement())
  enrollmentId String
  YearId       String

  totalAmount Float
  discount    Float @default(0)
  finalAmount Float
  paidAmount  Float @default(0)
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  status InvoiceStatus @default(UNPAID)

  enrollment ClassEnrollment @relation(fields: [enrollmentId], references: [id])
  schoolYear SchoolYear      @relation(fields: [YearId], references: [id])

  allocations PaymentAllocation[]
  @@index([branchId])
  @@index([branchId, YearId])
  @@unique([branchId, enrollmentId, YearId])
}

//////////////////////////////////////////////////////
// PAYMENT BATCH (PAIEMENT GROUPÉ)
//////////////////////////////////////////////////////

model PaymentBatch {
  id          Int             @id @default(autoincrement())
  parentId    String
  totalAmount Float
  status      PaymentStatus   @default(EN_ATTENTE)
  createdAt   DateTime        @default(now())
  parent      Parent          @relation(fields: [parentId], references: [id])
  payments    FamilyPayment[]
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
  @@index([branchId, parentId])
}

//////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////

model FamilyPayment {
  id                String                  @id @default(cuid())
  parentId          String
  batchId           Int?
  /// Montant de reference metier (devise de base de l'organisation)
  amount            Float
  /// Devise reellement percue a la caisse
  receivedCurrency  CurrencyCode            @default(USD)
  /// Montant perçu dans receivedCurrency
  receivedAmount    Float?
  /// Taux applique au moment du paiement (audit)
  exchangeRateUsed  Float?
  method            PaymentMethod
  transactionRef    String
  notes             String?
  status            PaymentStatus           @default(EN_ATTENTE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now())
  parent            Parent                  @relation(fields: [parentId], references: [id])
  batch             PaymentBatch?           @relation(fields: [batchId], references: [id])
  allocations       PaymentAllocation[]
  mobileTx          MobileMoneyTransaction?
  events            PaymentEvent[]
  fraisId           String
  frais             Frais?                  @relation(fields: [fraisId], references: [id], onDelete: Restrict)
  classEnrollment   ClassEnrollment?        @relation(fields: [classEnrollmentId], references: [id], onDelete: Cascade)
  classEnrollmentId String
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Caissier / utilisateur ayant enregistré le paiement
  createdByUserId   String?
  createdByUser     User?                 @relation("FamilyPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([fraisId])
  @@index([classEnrollmentId])
  @@index([transactionRef])
  @@index([branchId])
  @@index([branchId, parentId])
  @@index([branchId, createdAt])
  @@index([branchId, receivedCurrency])
  @@index([branchId, status, classEnrollmentId, fraisId])
  @@index([branchId, createdByUserId, createdAt])
  @@unique([branchId, transactionRef])
}

model CashierExpense {
  id             String   @id @default(cuid())
  transactionRef String
  amount         Float
  description    String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Caissier / utilisateur ayant enregistré la dépense
  createdByUserId String?
  createdByUser   User?    @relation("CashierExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  @@index([branchId])
  @@index([branchId, createdByUserId, createdAt])
  @@unique([branchId, transactionRef])
}

model CashierOpeningBalance {
  id        String   @id @default(cuid())
  amount    Float
  /// Jour civil du solde d'ouverture (minuit UTC localise cote app)
  date      DateTime @db.Date
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([branchId, date])
}

/// Taux de change par organisation (partages par toutes les branches)
model ExchangeRate {
  id             String       @id @default(cuid())
  fromCurrency   CurrencyCode
  toCurrency     CurrencyCode
  /// 1 unite fromCurrency = rate unites toCurrency
  rate           Float
  isActive       Boolean      @default(true)
  /// Un seul taux selectionne par organisation : fromCurrency = devise de base
  isSelected     Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, fromCurrency, toCurrency])
  @@index([organizationId, isActive])
  @@index([organizationId, isSelected])
}

model PaymentAllocation {
  id              Int    @id @default(autoincrement())
  familyPaymentId String
  invoiceId       Int
  amount          Float
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  familyPayment FamilyPayment @relation(fields: [familyPaymentId], references: [id])
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@unique([familyPaymentId, invoiceId])
  @@index([branchId])
}

//////////////////////////////////////////////////////
// MOBILE MONEY
//////////////////////////////////////////////////////

model MobileMoneyTransaction {
  id          Int           @id @default(autoincrement())
  paymentId   String        @unique
  provider    PaymentMethod
  phoneNumber String
  externalId  String        @unique
  status      PaymentStatus
  rawResponse String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  payment FamilyPayment @relation(fields: [paymentId], references: [id])
  @@index([branchId])
  @@index([branchId, externalId])
}

//////////////////////////////////////////////////////
// LOGS / EVENTS
//////////////////////////////////////////////////////

model PaymentEvent {
  id        Int      @id @default(autoincrement())
  paymentId String
  type      String
  message   String?
  createdAt DateTime @default(now())
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payment FamilyPayment @relation(fields: [paymentId], references: [id])
  @@index([branchId])
  @@index([branchId, paymentId])
}

//////////////////////////////////////////////////////
// DISCOUNTS
//////////////////////////////////////////////////////

enum DiscountScope {
  PARENT
  GROUP
  ORPHAN
}

model DiscountRule {
  id          Int              @id @default(autoincrement())
  scope       DiscountScope // 🔥 PARENT / ORPHAN / GROUP
  category    StudentCategory? // ORPHAN, VIP, etc (optionnel)
  parentId    String? // si scope = PARENT
  minChildren Int?
  percentage  Float
  /// Type de frais sur lequel la remise s'applique (inscription). Null = tous les frais (legacy).
  typeFraisId String?
  createdAt   DateTime         @default(now())
  parent      Parent?          @relation(fields: [parentId], references: [id])
  typeFrais   TypeFrais?       @relation(fields: [typeFraisId], references: [id], onDelete: SetNull)
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
  @@index([branchId, scope])
  @@index([typeFraisId])
}

model Transaction {
  id        String   @id @default(uuid())
  reference String   @unique
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId])
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  MOBILE_MONEY
  CARTE_BANCAIRE
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum PaymentMethod {
  ESPECES
  MPESA
  AIRTEL_MONEY
  ORANGE_MONEY
  CARTE
  BANQUE
}

enum CurrencyCode {
  USD
  CDF
  AOA
}

enum PaymentStatus {
  VALIDE
  ANNULE
  EN_ATTENTE
  REMBOURSE
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Motif de sortie anticipée (élève / enseignant / personnel).
enum AttendanceExitReason {
  MALADIE
  URGENCE
  AUTORISE
  AUTRE
}

enum AttendanceSubjectType {
  STUDENT
  TEACHER
  PERSONNEL
}

enum AbsenceCaseStatus {
  OPEN
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  CLEARED
}

enum AppNotificationType {
  ABSENCE
  JUSTIFICATION_SUBMITTED
  JUSTIFICATION_DECISION
  RETURN
}

/// Absence auto (aucun scan / pointage) + justification / retour.
model AbsenceCase {
  id                      String                @id @default(cuid())
  branchId                String
  branch                  Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organizationId          String
  userId                  String
  user                    User                  @relation("AbsenceCaseSubject", fields: [userId], references: [id], onDelete: Cascade)
  subjectType             AttendanceSubjectType
  sourceKey               String
  studentId               String?
  teacherId               String?
  personnelId             String?
  sessionId               String?
  studentAttendanceId     String?               @unique
  studentAttendance       StudentAttendance?    @relation(fields: [studentAttendanceId], references: [id], onDelete: Cascade)
  teacherAttendanceId     String?               @unique
  teacherAttendance       TeacherAttendance?    @relation(fields: [teacherAttendanceId], references: [id], onDelete: Cascade)
  personnelAttendanceId   String?               @unique
  personnelAttendance     PersonnelAttendance?  @relation(fields: [personnelAttendanceId], references: [id], onDelete: Cascade)
  occurredOn              DateTime
  contextLabel            String
  status                  AbsenceCaseStatus     @default(OPEN)
  justification           String?
  justifiedAt             DateTime?
  reviewComment           String?
  reviewedById            String?
  reviewedBy              User?                 @relation("AbsenceCaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  absenceNotifiedAt       DateTime?
  returnNotifiedAt        DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  notifications           AppNotification[]

  @@unique([branchId, sourceKey])
  @@index([branchId, status])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([occurredOn])
}

model AppNotification {
  id            String              @id @default(cuid())
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AppNotificationType
  title         String
  body          String
  href          String?
  absenceCaseId String?
  absenceCase   AbsenceCase?        @relation(fields: [absenceCaseId], references: [id], onDelete: Cascade)
  readAt        DateTime?
  createdAt     DateTime            @default(now())

  @@index([userId, readAt])
  @@index([branchId, userId, createdAt])
  @@index([absenceCaseId])
}

enum StudentCategory {
  NORMAL
  ORPHAN
  VIP
  SPONSORED
  GROUPE
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?
  activeBranchId String?

  @@unique([token])
  @@index([userId])
  @@index([activeOrganizationId])
  @@index([activeBranchId])
  @@index([userId, activeOrganizationId])
  @@index([userId, activeBranchId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId])
  @@index([accountId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Organization {
  id                String             @id
  name              String
  slug              String
  logo              String?
  createdAt         DateTime
  metadata          String?
  isArchived        Boolean            @default(false)
  archivedAt        DateTime?
  archivedById      String?
  organizationroles OrganizationRole[]
  members           Member[]
  branches          Branch[]
  invitations       Invitation[]
  organizationSupportAgents OrganizationSupportAgent[]
  platformSupportEscalations PlatformSupportEscalation[]
  exchangeRates     ExchangeRate[]

  @@unique([name])
  @@unique([slug])
  @@index([isArchived])
  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@unique([organizationId, role])
  @@map("organizationRole")
}

model Member {
  id             String         @id
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String         @default("member")
  createdAt      DateTime
  isArchived     Boolean        @default(false)
  archivedAt     DateTime?
  archivedById   String?
  branchMember   BranchMember[]
  organizationSupportAgent OrganizationSupportAgent?

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, isArchived])
  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@index([inviterId])
  @@index([organizationId, email])
  @@map("invitation")
}

model Branch {
  id               String       @id @default(cuid())
  name             String
  code             String?
  image            Json?
  /// Texte optionnel affiché à la une sur la page d'accueil (spotlight)
  note             String?      @db.Text
  adresse          String?
  province         String?
  ville            String?
  commune          String?
  pays             String?
  idnat            String?
  tel              String?
  latitude         Float
  longitude        Float
  attendanceRadius Int          @default(10)
  organizationId   String
  typebranch      TypeBrache
  educationSystem EducationSystem @default(CONGOLAIS)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentAttendance StudentAttendance[]
  branchemembers            BranchMember[]
  classes            Classe[]
  paymentBatch PaymentBatch[]
  familyPayment FamilyPayment[]
  fiche fiche[]
  eventType EventType[]
  period period[]
  cours Cours[]
  schoolYear SchoolYear[]
  typeFrais TypeFrais[]
  option Option[]
  coursPonderations CoursOptionPonderation[]
  classEnrollment ClassEnrollment[]
  section Section[]
  semester semester[]
  frais Frais[]
  calendarEvent CalendarEvent[]
  periodResultLock PeriodResultLock[]
  cashierExpense CashierExpense[]
  cashierOpeningBalance CashierOpeningBalance[]
  invoice Invoice[]
  creneau Creneau[]
  paymentAllocation PaymentAllocation[]
  teaching           Teaching[]
  mobileMoneyTransaction MobileMoneyTransaction[]
  branchInvitation   BranchInvitation[]
  attendanceSessions AttendanceSession[]
  teacherAttendance TeacherAttendance[]
  personnelAttendance PersonnelAttendance[]
  studentGrade StudentGrade[]
  parentFeedback ParentFeedback[]
  transaction Transaction[]
  discountRule DiscountRule[]
  paymentEvent PaymentEvent[]
  partnaires Partnaire[]
  organizationSupportBranchScopes OrganizationSupportBranchScope[]
  registrationRequests RegistrationRequest[]
  registrationInfos    BranchRegistrationInfo[]
  jobApplications      JobApplication[]
  targetStudentLinks   StudentBranchLink[] @relation("TargetBranchLinks")
  sourceStudentLinks   StudentBranchLink[] @relation("SourceBranchLinks")
  issuedDocuments      IssuedDocument[]
  libraryBooks         LibraryBook[]
  supportTickets       PlatformSupportEscalation[]
  onlineAssignments    OnlineAssignment[]
  primaryDomains       BranchPrimaryDomain[]
  absenceCases         AbsenceCase[]
  appNotifications     AppNotification[]
  /// En-tête listing finalistes Excel : province, centre, établissement, option, gestion…
  examExportMeta       Json?

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, typebranch])
  @@index([code])
  @@unique([organizationId, code])
}

/// Domaines du bulletin primaire (par branche) — créables / modifiables
model BranchPrimaryDomain {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Code stable (ex. LANGUES, ARTS, ou slug custom)
  code       String
  /// Libellé bulletin (ex. DOMAINE DES LANGUES)
  label      String
  /// Libellé court UI (ex. Langues)
  shortLabel String
  sortOrder  Int      @default(0)
  /// Domaine catalogue RDC seedé (non supprimable)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId, sortOrder])
}

/// Infos publiques d'inscription en ligne (conditions, frais, programme rentrée), par école / année.
model BranchRegistrationInfo {
  id           String  @id @default(cuid())
  branchId     String
  schoolYearId String?
  isPublished  Boolean @default(false)

  termsTitle   String @default("Conditions d'inscription")
  termsContent String @db.Text

  registrationFeeRequired Boolean  @default(true)
  registrationFeeAmount   Decimal? @db.Decimal(12, 2)
  registrationFeeCurrency String   @default("CDF")
  registrationFeeLabel    String?
  registrationFeeDueNote  String?
  registrationFeeTypeId   String?

  /// [{ "date": "2026-09-01", "title": "...", "description": "..." }, ...]
  rentreeProgram Json?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@unique([branchId, schoolYearId])
  @@index([branchId, isPublished])
  @@index([schoolYearId])
}

model RegistrationRequest {
  id                 String                    @id @default(cuid())
  reference          String                    @unique
  branchId           String
  organizationId     String
  schoolYearId       String?
  status             RegistrationRequestStatus @default(PENDING)
  studentData        Json
  guardiansData      Json
  /// Relie les demandes multi-élèves d'une même soumission publique
  siblingGroupId     String?
  requestedLevel     String?
  requestedSection   String?
  requestedOption    String?
  photoUrl           String?
  consentAccepted    Boolean                   @default(false)
  termsAcceptedAt    DateTime?
  termsInfoId        String?
  confirmedById      String?
  confirmedAt        DateTime?
  registeredById     String?
  registeredAt       DateTime?
  studentId          String?
  rejectedReason     String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  branch             Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, status, createdAt])
  @@index([organizationId, branchId])
  @@index([schoolYearId])
  @@index([studentId])
  @@index([siblingGroupId])
  @@index([branchId, siblingGroupId])
}

enum RegistrationRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  REGISTERED
  ARCHIVED
}

enum JobApplicationType {
  TEACHER
  PERSONNEL
}

enum JobApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  HIRED
  CANCELLED
}

model JobApplication {
  id                String               @id @default(cuid())
  reference         String               @unique
  branchId          String
  organizationId    String
  applicationType   JobApplicationType
  status            JobApplicationStatus @default(PENDING)

  nom               String
  postnom           String
  prenom            String
  sexe              String
  dateOfBirth       DateTime
  telephone         String
  email             String
  address           String
  photoUrl          String?

  desiredSubjects   String?
  desiredLevels     String?
  yearsOfExperience Int?
  desiredOrgRole    String?

  experienceSummary String?              @db.Text
  educationSummary  String?              @db.Text
  skills            String?              @db.Text
  availability      String?
  motivation        String?              @db.Text

  cvUrl             String
  coverLetterUrl    String

  consentAccepted   Boolean              @default(false)

  reviewedById      String?
  reviewedAt        DateTime?
  acceptedById      String?
  acceptedAt        DateTime?
  rejectedReason    String?
  hiredById         String?
  hiredAt           DateTime?
  teacherId         String?
  personnelId       String?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, status, createdAt])
  @@index([organizationId, branchId])
  @@index([email])
  @@index([applicationType])
}

model Partnaire {
  id          String    @id @default(cuid())
  name        String
  slug        String?
  type        String?
  secteur     String?
  description String?   @db.Text
  image       String
  tel         String
  email       String?
  website     String?
  adresse     String?
  ville       String?
  pays        String?
  contactName String?
  contactRole String?
  logo        String?
  documentUrl String?
  contractRef String?
  contractStart DateTime?
  contractEnd   DateTime?
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  notes       String?   @db.Text
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug])
  @@index([branchId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([ville])
  @@index([pays])
}

model BranchMember {
  id String @id @default(cuid())

  branchId String
  memberId String
  role BranchRole
  teacher Teacher[]
  parent Parent[]
  schedule Schedule[]
  personel Personnel[]
  student Student[]
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([branchId, memberId])
  @@index([branchId])
  @@index([memberId])
  @@index([branchId, role])
  @@index([memberId, role])
}

enum BranchRole {
  DIRECTOR
  CAISSIER
  ADMIN
  TEACHER
  PARENT
  STUDENT
}
enum TypeBrache {
  PRIMAIRE
  SECONDAIRE
  ATELIER
  CENTRE_FORMATION
  UNIVERSITE
}

enum EducationSystem {
  CONGOLAIS
  ANGOLAIS
  ANGLAIS
}

enum HoraireType {
  COMPLET
  REDUIT
}

enum StudentLinkType {
  IMPORTED
  NATIVE
}

enum IssuedDocumentType {
  BULLETIN
  BREVET
  RELEVE_NOTES
  ATTESTATION
  ATTESTATION_PARTICIPATION
}

model StudentBranchLink {
  id             String          @id @default(cuid())
  studentId      String
  targetBranchId String
  sourceBranchId String
  linkType       StudentLinkType @default(IMPORTED)
  isActive       Boolean         @default(true)
  enrolledAt     DateTime        @default(now())
  endedAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetBranch Branch  @relation("TargetBranchLinks", fields: [targetBranchId], references: [id], onDelete: Cascade)
  sourceBranch Branch  @relation("SourceBranchLinks", fields: [sourceBranchId], references: [id], onDelete: Cascade)

  @@unique([studentId, targetBranchId])
  @@index([targetBranchId])
  @@index([sourceBranchId])
  @@index([studentId])
  @@index([targetBranchId, isActive])
}

model IssuedDocument {
  id           String             @id @default(cuid())
  branchId     String
  studentId    String
  schoolYearId String?
  documentType IssuedDocumentType
  title        String
  metadata     Json?
  issuedAt     DateTime           @default(now())
  issuedById   String?
  pdfUrl       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@index([branchId, documentType])
  @@index([studentId])
  @@index([branchId, studentId])
  @@index([schoolYearId])
}

model BranchInvitation {
  id String @id @default(cuid())

  email    String
  branchId String

  role  BranchRole
  token String     @unique

  expiresAt DateTime
  accepted  Boolean  @default(false)

  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([email])
  @@unique([branchId, email])
}

// ─── Bibliothèque scolaire (PDF/EPUB, lecture seule élèves) ───────────────────

enum LibraryCycle {
  PRIMAIRE
  SECONDAIRE
  HUMANITES
  FORMATION
  UNIVERSITE
}

enum LibraryFileType {
  PDF
  EPUB
}

enum LibraryVisibility {
  STUDENTS
}

enum LibrarySource {
  SCHOOL_UPLOAD
  OPEN_LICENSE
  PLATFORM_CATALOG
}

model LibraryBook {
  id          String   @id @default(cuid())
  title       String
  author      String?
  publisher   String?
  description String?  @db.Text
  coverImage  String?

  /// Chemin stockage privé côté serveur (jamais exposé au client)
  fileUrl     String
  fileType    LibraryFileType
  fileSize    Int?
  pageCount   Int?
  language    String   @default("fr")
  license     String?
  isbn        String?

  cycle       LibraryCycle?
  level       String?
  section     String?
  subject     String?
  category    String?
  tags        String[] @default([])

  visibility    LibraryVisibility @default(STUDENTS)
  allowDownload Boolean           @default(false)
  isActive      Boolean           @default(true)
  source        LibrarySource     @default(SCHOOL_UPLOAD)
  sortOrder     Int               @default(0)
  viewCount     Int               @default(0)

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([branchId])
  @@index([branchId, isActive])
  @@index([cycle])
  @@index([level])
  @@index([subject])
  @@index([category])
  @@index([visibility])
  @@index([fileType])
}

// ─── Support plateforme (équipe Klambocore) ───────────────────────────────────

model PlatformSupportAgent {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayTitle String?
  bio          String?  @db.Text
  specialties  String[] @default([])
  image        String?
  isActive     Boolean  @default(true)
  isLead       Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedEscalations PlatformSupportEscalation[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("platformSupportAgent")
}

// ─── Support organisation (agents internes à une école) ─────────────────────

model OrganizationSupportAgent {
  id             String   @id @default(cuid())
  memberId       String   @unique
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayTitle   String?
  bio            String?  @db.Text
  specialties    String[] @default([])
  isActive       Boolean  @default(true)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branchScopes   OrganizationSupportBranchScope[]
  escalations    PlatformSupportEscalation[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("organizationSupportAgent")
}

model OrganizationSupportBranchScope {
  id        String  @id @default(cuid())
  supportId String
  support   OrganizationSupportAgent @relation(fields: [supportId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([supportId, branchId])
  @@index([supportId])
  @@index([branchId])
  @@map("organizationSupportBranchScope")
}

enum PlatformSupportEscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketChannel {
  ESTABLISHMENT
  PLATFORM
}

// Demande support : établissement (agents locaux) ou escalade Klambocore
model PlatformSupportEscalation {
  id                      String   @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSupportId   String?
  organizationSupport     OrganizationSupportAgent? @relation(fields: [organizationSupportId], references: [id], onDelete: SetNull)
  requesterUserId         String
  requesterUser           User @relation("EscalationRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  assignedPlatformAgentId String?
  assignedPlatformAgent   PlatformSupportAgent? @relation(fields: [assignedPlatformAgentId], references: [id], onDelete: SetNull)
  branchId                String?
  branch                  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  channel                 SupportTicketChannel @default(PLATFORM)
  subject                 String
  message                 String   @db.Text
  status                  PlatformSupportEscalationStatus @default(OPEN)
  priority                String   @default("normal")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  resolvedAt              DateTime?

  @@index([organizationId])
  @@index([requesterUserId])
  @@index([status])
  @@index([channel])
  @@index([branchId])
  @@index([assignedPlatformAgentId])
  @@map("platformSupportEscalation")
}

// ─── Devoirs / évaluations en ligne (weekend) ─────────────────────────────────

enum OnlineAssignmentType {
  DEVOIR
  EVALUATION
}

enum OnlineAssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum OnlineQuestionType {
  SHORT_TEXT
  LONG_TEXT
  FILE
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum OnlineSubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
}

model OnlineAssignment {
  id                 String                 @id @default(cuid())
  branchId           String
  branch             Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schoolYearId       String
  schoolYear         SchoolYear             @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  classId            String
  classe             Classe                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseId           String
  cours              Cours                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teachingId         String
  teacherId          String
  teacher            Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  periodId           Int
  type               OnlineAssignmentType   @default(DEVOIR)
  title              String
  description        String?                @db.Text
  status             OnlineAssignmentStatus @default(DRAFT)
  startAt            DateTime
  dueAt              DateTime
  /// Jour calendaire pour l'unicité (classe + cours + type + jour)
  activityDate       DateTime               @db.Date
  maxAttempts        Int                    @default(1)
  totalPoints        Float                  @default(0)
  resultsPublished   Boolean                @default(false)
  shuffleOptions     Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  questions          OnlineQuestion[]
  submissions        OnlineSubmission[]
  fiche              fiche?

  @@unique([branchId, classId, courseId, type, activityDate])
  @@index([branchId])
  @@index([branchId, classId, dueAt])
  @@index([teacherId])
  @@index([schoolYearId])
  @@index([status, startAt, dueAt])
}

model OnlineQuestion {
  id                String             @id @default(cuid())
  assignmentId      String
  assignment        OnlineAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type              OnlineQuestionType
  position          Int                @default(0)
  statementHtml     String             @db.Text
  points            Float              @default(1)
  settingsJson      Json?
  correctAnswerJson Json?
  options           OnlineQuestionOption[]
  answers           OnlineAnswer[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([assignmentId, position])
}

model OnlineQuestionOption {
  id         String         @id @default(cuid())
  questionId String
  question   OnlineQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  position   Int            @default(0)
  isCorrect  Boolean        @default(false)

  @@index([questionId, position])
}

model OnlineSubmission {
  id               String                 @id @default(cuid())
  assignmentId     String
  assignment       OnlineAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempt          Int                    @default(1)
  status           OnlineSubmissionStatus @default(DRAFT)
  provisionalScore Float?
  finalScore       Float?
  startedAt        DateTime               @default(now())
  submittedAt      DateTime?
  gradedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  answers          OnlineAnswer[]
  files            OnlineSubmissionFile[]

  @@unique([assignmentId, studentId, attempt])
  @@index([assignmentId, status])
  @@index([studentId])
}

model OnlineAnswer {
  id             String           @id @default(cuid())
  submissionId   String
  submission     OnlineSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId     String
  question       OnlineQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText     String?          @db.Text
  answerJson     Json?
  awardedPoints  Float?
  isCorrect      Boolean?
  needsManual    Boolean          @default(false)
  teacherFeedback String?         @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model OnlineSubmissionFile {
  id           String           @id @default(cuid())
  submissionId String
  submission   OnlineSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String?
  name         String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime         @default(now())

  @@index([submissionId])
}
